{
  "name": "shokker-paint-booth-v6",
  "version": "10.0.3",
  "description": "Shokker Paint Booth V10 \u2014 iRacing Spec Map Tool",
  "main": "main.js",
  "author": "Shokker Group",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "copy-server": "node copy-server-assets.js",
    "sync-runtime": "node ../scripts/sync-runtime-copies.js --write",
    "check-runtime-sync": "node ../scripts/sync-runtime-copies.js --check",
    "prebuild": "npm run copy-server",
    "build": "electron-builder --win --x64",
    "build:contributors": "node build-contributor-package.js",
    "publish": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shokker.paintbooth.v6",
    "productName": "Shokker Paint Booth V10",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis-web",
      "icon": "icon.ico",
      "artifactName": "ShokkerPaintBoothV10-${version}-Web-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Shokker Paint Booth V10",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "license.html",
      "license-preload.js",
      "update-check.js",
      "spb-license-secrets.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!pyserver/**",
          "!output/**",
          "!_staging/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log",
          "!_copy-manifest.json",
          "!server.exe",
          "!shokker-paint-booth-v5.exe",
          "!python/Lib/site-packages/**/tests/**",
          "!python/Lib/site-packages/**/test/**",
          "!python/Lib/site-packages/**/*.pyi",
          "!python/Lib/site-packages/pip/**",
          "!python/Lib/site-packages/pip-*.dist-info/**",
          "!python/Lib/site-packages/**/*.a",
          "!python/Lib/site-packages/**/*.lib",
          "!assets/defaults/ORIGINAL_blank_canvas_2048_white.tga",
          "!assets/patterns/80s/synthwave_pure.png",
          "!assets/patterns/80s/synthwave_futureshock.png",
          "!assets/patterns/80s/synthwave_future_pure.png",
          "!image_forge/_originals/**",
          "!thumbnails/audit/**",
          "!thumbnails/_spb74_test/**",
          "!assets/shokker-forge-showcase/source/**",
          "!assets/reference_textures/colorshoxx/_wilds_source_contact.png",
          "!assets/reference_textures/colorshoxx/ai_reference_2026_05_27/source/**",
          "!thumbnails/base_spec_preview/**"
        ]
      }
    ],
    "asar": true,
    "publish": {
      "provider": "generic",
      "url": "https://pub-9969ab01838a4d69bb55822f42553904.r2.dev",
      "channel": "latest"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
